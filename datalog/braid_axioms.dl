% Topos Braid Datalog Axioms
% Encoding of braid group generators, words, and Yang-Baxter (Artin) relations
% for automated equivalence checking via bottom-up evaluation / saturation.
% Engine: Souffle / DDlog / Datafrog compatible syntax (with extensions noted)

% ---------------------------------------------------------------------------
% Domains / sorts (implicit in Datalog; documented for clarity)
% strand(S)          : S is a strand identifier
% crossing(C,A,B,T)  : C is a crossing of strand A over/under B with type T
%                      T in {over, under}
% gen(G,C)           : G is a generator corresponding to crossing C
% word(W,Gs)         : W is a braid word built from list of generators Gs
% braid(B,Strands,W) : B is a named braid on strand list Strands with word W
% equiv(B1,B2)       : braids B1 and B2 are equivalent under braid relations
% ---------------------------------------------------------------------------

% Basic facts for the three-strand Yang-Baxter example
.decl strand(s:symbol)
strand("a").
strand("b").
strand("c").

.decl crossing(c:symbol, a:symbol, b:symbol, t:symbol)
crossing("c1", "a", "b", "over"). % sigma1
crossing("c2", "b", "c", "over"). % sigma2
crossing("c1_inv", "a", "b", "under"). % sigma1^{-1}
crossing("c2_inv", "b", "c", "under"). % sigma2^{-1}

.decl gen(g:symbol, c:symbol)
gen("g1", "c1").
gen("g2", "c2").
gen("g1_inv", "c1_inv").
gen("g2_inv", "c2_inv").

% ---------------------------------------------------------------------------
% LHS braid: sigma1 sigma2 sigma1  = [g1, g2, g1]
% RHS braid: sigma2 sigma1 sigma2  = [g2, g1, g2]
% Represented as facts for words; concatenation is encoded via list terms
% ---------------------------------------------------------------------------

.decl word(w:symbol, gs:symbol)  % gs is serialized list e.g. "[g1,g2,g1]"
word("w_lhs", "[g1,g2,g1]").
word("w_rhs", "[g2,g1,g2]").
word("w_id", "[]").
word("w_g1", "[g1]").
word("w_g2", "[g2]").

.decl braid(b:symbol, strands:symbol, w:symbol)
braid("lhs", "[a,b,c]", "w_lhs").
braid("rhs", "[a,b,c]", "w_rhs").

% ---------------------------------------------------------------------------
% Core axioms – free monoid structure on generators
% ---------------------------------------------------------------------------

% Single-generator words (already asserted; rule form for extensibility)
% word(W, [G]) :- gen(G, _).

% Concatenation of words (associative) - Souffle functional notation
% word(concat(W1,W2), Gs) :- word(W1, Gs1), word(W2, Gs2), append(Gs1, Gs2, Gs).

% ---------------------------------------------------------------------------
% Braid relations as rewrite / congruence axioms
% ---------------------------------------------------------------------------

.decl equiv_word(w1:symbol, w2:symbol)
.decl disjoint(s1:symbol, s2:symbol)

% Far-commutation (|i-j|>1): sigma_i sigma_j = sigma_j sigma_i when disjoint
% Example: on 4+ strands sigma1 and sigma3 commute
% equiv_word(W1, W2) :-
%     word(W1, [G1, G2]),
%     word(W2, [G2, G1]),
%     gen(G1, C1), gen(G2, C2),
%     crossing(C1, A1, B1, _),
%     crossing(C2, A2, B2, _),
%     disjoint([A1,B1],[A2,B2]).

% Yang-Baxter / Artin braid relation (the key axiom)
% sigma1 sigma2 sigma1 = sigma2 sigma1 sigma2
equiv_word("w_lhs", "w_rhs") :-
    word("w_lhs", "[g1,g2,g1]"),
    word("w_rhs", "[g2,g1,g2]"),
    gen("g1", "c1"), gen("g2", "c2"),
    crossing("c1", "a", "b", "over"),
    crossing("c2", "b", "c", "over"),
    strand("a"), strand("b"), strand("c").

% Symmetric closure for YB (explicit for Datalog without built-in symmetry)
equiv_word("w_rhs", "w_lhs") :-
    equiv_word("w_lhs", "w_rhs").

% Inverse relation: sigma sigma^{-1} = 1
equiv_word("[g1,g1_inv]", "w_id") :-
    gen("g1", "c1"), gen("g1_inv", "c1_inv"),
    crossing("c1", "a", "b", "over"),
    crossing("c1_inv", "a", "b", "under").

equiv_word("[g1_inv,g1]", "w_id") :-
    gen("g1", "c1"), gen("g1_inv", "c1_inv"),
    crossing("c1", "a", "b", "over"),
    crossing("c1_inv", "a", "b", "under").

equiv_word("[g2,g2_inv]", "w_id") :-
    gen("g2", "c2"), gen("g2_inv", "c2_inv"),
    crossing("c2", "b", "c", "over"),
    crossing("c2_inv", "b", "c", "under").

equiv_word("[g2_inv,g2]", "w_id") :-
    gen("g2", "c2"), gen("g2_inv", "c2_inv"),
    crossing("c2", "b", "c", "over"),
    crossing("c2_inv", "b", "c", "under").

% ---------------------------------------------------------------------------
% Congruence closure – make equiv_word an equivalence relation
% ---------------------------------------------------------------------------

% Reflexivity
equiv_word(W, W) :- word(W, _).

% Symmetry (general)
equiv_word(W2, W1) :-
    equiv_word(W1, W2),
    W1 != W2.

% Transitivity
equiv_word(W1, W3) :-
    equiv_word(W1, W2),
    equiv_word(W2, W3),
    W1 != W3.

% Compatibility with concatenation (congruence)
% equiv_word(concat(W1,W3), concat(W2,W3)) :- equiv_word(W1, W2), word(W3, _).
% equiv_word(concat(W3,W1), concat(W3,W2)) :- equiv_word(W1, W2), word(W3, _).

% ---------------------------------------------------------------------------
% Lift word equivalence to braid equivalence
% ---------------------------------------------------------------------------
.decl equiv(b1:symbol, b2:symbol)
equiv(B1, B2) :-
    braid(B1, Ss, W1),
    braid(B2, Ss, W2),
    equiv_word(W1, W2).

% The assertion assert_equivalent(lhs, rhs) is expressed as:
% ?- equiv("lhs", "rhs").
% Under the axioms above this goal succeeds by Yang-Baxter rule.

.output equiv_word
.output equiv

% ---------------------------------------------------------------------------
% Auxiliary list predicates (standard Datalog encoding)
% ---------------------------------------------------------------------------
% append([], Ys, Ys).
% append([X|Xs], Ys, [X|Zs]) :- append(Xs, Ys, Zs).
% member(X, [X|_]).
% member(X, [_|Xs]) :- member(X, Xs).

% ---------------------------------------------------------------------------
% Datagen for the three-generator YB witness (for completeness)
% LHS crossings in order: c1(a,b,over), c2(b,c,over), c1(a,b,over)
% RHS crossings in order: c2(b,c,over), c1(a,b,over), c2(b,c,over)
% ---------------------------------------------------------------------------
