(* Topos Kernel – NESL Nested Data-Parallel Implementation
   400-line dense core for braid word evaluation, Yang-Baxter saturation,
   and Jones polynomial computation under nested parallelism.
   All operations are data-parallel over strand arrays, crossing vectors,
   and Laurent coefficient maps represented as nested sequences.
*)

(* Primitive scalar types *)
type Strand = int; (* 0-based index into strand vector *)
type CType = int; (* 0 = over, 1 = under *)
type Orient = int; (* 0 = LtoR, 1 = RtoL *)

(* Crossing record – flat for vectorisation *)
type Crossing = (Strand, Strand, CType, Orient);

(* Generator is either a crossing index or a twist *)
type GenKind = int; (* 0 = Cross, 1 = Twist, 2 = Id *)
type Generator = (GenKind, int, int); (* kind, arg1, arg2 *)

(* Laurent polynomial as sparse coefficient sequence (exp, coeff) pairs *)
type Term = (int, int); (* exponent, coefficient *)
type Laurent = [Term];

(* Braid = strand count + flat generator sequence *)
type Braid = (int, [Generator]);

(* ------------------------------------------------------------------ *)
(* Utility nested-parallel primitives (NESL style) *)
(* ------------------------------------------------------------------ *)

function length(a) = #a;

function singleton(x) = [x: i in [0]];

function append(a, b) =
  let n = #a;
  in a ++ b;

function flatten(a) = flatten(a); (* built-in *)

function map(f, a) = {f(x): x in a};

function zip(a, b) = {(x,y): x in a; y in b};

function filter(p, a) = {x: x in a | p(x)};

function reduce(op, z, a) =
  if #a == 0 then z
  else let mid = #a / 2;
           l = reduce(op, z, a[0:mid]);
           r = reduce(op, z, a[mid:#a]);
       in op(l, r);

function scan(op, z, a) =
  if #a == 0 then []
  else let mid = #a / 2;
           l = scan(op, z, a[0:mid]);
           r = scan(op, op(l[#l-1], z), a[mid:#a]);
       in l ++ r;

(* Parallel prefix for writhe accumulation *)
function plus(x, y) = x + y;
function times(x, y) = x * y;

(* ------------------------------------------------------------------ *)
(* Strand and crossing constructors *)
(* ------------------------------------------------------------------ *)

function mk_strand(i) = i;

function mk_crossing(u, l, t, o) = (u, l, t, o);

function is_over(c) = c[2] == 0;
function is_under(c) = c[2] == 1;

(* ------------------------------------------------------------------ *)
(* Braid construction – data-parallel over generator lists *)
(* ------------------------------------------------------------------ *)

function empty_braid(n) = (n, []);

function add_crossing(b, u, l, t) =
  let (n, gs) = b;
      g = (0, u, l); (* GenKind Cross *)
  in (n, gs ++ [g]);

function add_twist(b, s, turns) =
  let (n, gs) = b;
      g = (1, s, turns);
  in (n, gs ++ [g]);

function compose_braids(b1, b2) =
  let (n1, gs1) = b1;
      (n2, gs2) = b2;
  in if n1 != n2 then error("strand mismatch")
      else (n1, gs1 ++ gs2);

(* Parallel generation of pure braid generators σ_i *)
function sigma(n, i, over) =
  let gs = [(0, i, i+1): j in [0] | over]
        ++ [(0, i, i+1): j in [0] | not over]; (* under variant *)
  in (n, gs);

(* ------------------------------------------------------------------ *)
(* Yang-Baxter rewrite – nested parallel pattern matching *)
(* ------------------------------------------------------------------ *)

(* Detect a Yang-Baxter triple in a window of three generators *)
function is_yb_window(g1, g2, g3) =
  let (k1, a1, b1) = g1;
      (k2, a2, b2) = g2;
      (k3, a3, b3) = g3;
  in k1 == 0 and k2 == 0 and k3 == 0 and
      a1 == a3 and b1 == a2 and b2 == b3 and
      a1 + 1 == b1 and a2 + 1 == b2;

(* Rewrite σ1 σ2 σ1 → σ2 σ1 σ2 (or the converse) *)
function yb_rewrite(g1, g2, g3) =
  let (k1, a1, b1) = g1;
      (k2, a2, b2) = g2;
  in [(0, a2, b2), (0, a1, b1), (0, a2, b2)];

(* Sliding window parallel rewrite over the whole word *)
function apply_yb_once(gs) =
  let n = #gs;
      windows = {(gs[i], gs[i+1], gs[i+2], i): i in [0:n-2]};
      matches = {(w, idx): (w, idx) in windows | is_yb_window(w[0], w[1], w[2])};
  in if #matches == 0 then gs
      else let (w, idx) = matches[0];
               prefix = gs[0:idx];
               rewritten = yb_rewrite(w[0], w[1], w[2]);
               suffix = gs[idx+3:n];
           in prefix ++ rewritten ++ suffix;

(* Iterate until fixpoint – nested parallel saturation *)
function normalize_yb(gs) =
  let rec loop(cur) =
        let next = apply_yb_once(cur);
        in if #next == #cur and next == cur then cur
            else loop(next);
  in loop(gs);

function normalize_braid(b) =
  let (n, gs) = b;
  in (n, normalize_yb(gs));

(* ------------------------------------------------------------------ *)
(* Writhe computation – pure parallel reduction *)
(* ------------------------------------------------------------------ *)

function crossing_writhe(g) =
  let (k, a, b) = g;
  in if k == 0 then 1 else 0; (* simplified: each over counts +1 *)

function total_writhe(b) =
  let (n, gs) = b;
      ws = {crossing_writhe(g): g in gs};
  in reduce(plus, 0, ws);

(* ------------------------------------------------------------------ *)
(* Laurent polynomial arithmetic – nested data-parallel *)
(* ------------------------------------------------------------------ *)

function zero_laurent() = [];

function one_laurent() = [(0, 1)];

function var_a() = [(1, 1)];

function var_ainv() = [(-1, 1)];

(* Merge two sparse coefficient lists by exponent *)
function merge_terms(t1, t2) =
  let e1 = t1[0]; c1 = t1[1];
      e2 = t2[0]; c2 = t2[1];
  in if e1 == e2 then [(e1, c1 + c2)]
      else if e1 < e2 then [t1, t2]
      else [t2, t1];

function add_laurent(p, q) =
  let all = p ++ q;
      sorted = sort(all); (* by exponent *)
      grouped = group(sorted); (* group equal exponents *)
      summed = { (e, reduce(plus, 0, {c: (ee,c) in g}))
               : g in grouped; e = g[0][0] };
  in filter(fun t => t[1] != 0, summed);

function scale_laurent(k, p) =
  {(e, k * c): (e, c) in p};

function mul_laurent(p, q) =
  let products = flatten({ {(e1+e2, c1*c2): (e2,c2) in q}
                         : (e1,c1) in p });
  in add_laurent(products, []); (* normalise by adding to zero *)

function pow_laurent(p, n) =
  if n == 0 then one_laurent()
  else if n > 0 then
    let rec loop(i, acc) =
          if i == 0 then acc
          else loop(i-1, mul_laurent(acc, p));
    in loop(n, one_laurent())
  else
    let inv = {( -e, c): (e,c) in p};
    in pow_laurent(inv, -n);

(* ------------------------------------------------------------------ *)
(* Kauffman bracket & Jones polynomial – parallel state sum *)
(* ------------------------------------------------------------------ *)

function bracket_crossing(g) =
  let (k, a, b) = g;
  in if k != 0 then one_laurent()
      else add_laurent(mul_laurent(var_a(), one_laurent()),
                       mul_laurent(var_ainv(), one_laurent()));

function bracket_word(gs) =
  let factors = {bracket_crossing(g): g in gs};
  in reduce(mul_laurent, one_laurent(), factors);

function jones(b) =
  let (n, gs) = b;
      w = total_writhe(b);
      br = bracket_word(gs);
      norm_factor = pow_laurent(var_a(), -3 * w);
      sign = if (w % 2) == 0 then 1 else -1;
  in scale_laurent(sign, mul_laurent(norm_factor, br));

(* ------------------------------------------------------------------ *)
(* Parallel evaluation of many braids (batch invariance check) *)
(* ------------------------------------------------------------------ *)

function batch_jones(bs) =
  {jones(b): b in bs};

(* Demonstrate Yang-Baxter invariance in parallel *)
function yb_invariance_demo() =
  let n = 3;
      lhs = (n, [(0,0,1), (0,1,2), (0,0,1)]); (* σ1 σ2 σ1 *)
      rhs = (n, [(0,1,2), (0,0,1), (0,1,2)]); (* σ2 σ1 σ2 *)
      lhs_n = normalize_braid(lhs);
      rhs_n = normalize_braid(rhs);
      j_lhs = jones(lhs_n);
      j_rhs = jones(rhs_n);
  in (j_lhs, j_rhs, j_lhs == j_rhs);

(* ------------------------------------------------------------------ *)
(* Nested parallel generation of all length-k braid words *)
(* ------------------------------------------------------------------ *)

function all_generators(n) =
  flatten({ [(0,i,i+1), (0,i,i+1)]: i in [0:n-1] }); (* over & under *)

function braid_words(n, k) =
  if k == 0 then [ [ ] ]
  else let shorter = braid_words(n, k-1);
           gens = all_generators(n);
       in flatten({ {g ++ [x]: x in gens}: g in shorter });

(* ------------------------------------------------------------------ *)
(* Data-parallel Markov moves *)
(* ------------------------------------------------------------------ *)

function markov_conjugation(b, g) =
  let (n, gs) = b;
  in (n, [g] ++ gs ++ [g]); (* simplified cyclic shift *)

function markov_stabilize(b, over) =
  let (n, gs) = b;
      new_g = (0, n-1, n);
  in (n+1, gs ++ [new_g]);

(* ------------------------------------------------------------------ *)
(* Parallel reduction of braid word length via free reduction *)
(* ------------------------------------------------------------------ *)

function is_inverse_pair(g1, g2) =
  let (k1,a1,b1) = g1;
      (k2,a2,b2) = g2;
  in k1 == 0 and k2 == 0 and a1 == a2 and b1 == b2;

function free_reduce_once(gs) =
  let n = #gs;
      pairs = {(gs[i], gs[i+1], i): i in [0:n-1]};
      invs = {(p, idx): (p, idx) in pairs | is_inverse_pair(p[0], p[1])};
  in if #invs == 0 then gs
      else let (p, idx) = invs[0];
           in gs[0:idx] ++ gs[idx+2:n];

function free_reduce(gs) =
  let rec loop(cur) =
        let next = free_reduce_once(cur);
        in if #next == #cur then cur else loop(next);
  in loop(gs);

(* ------------------------------------------------------------------ *)
(* Full normalisation pipeline *)
(* ------------------------------------------------------------------ *)

function full_normalize(b) =
  let (n, gs) = b;
      gs1 = free_reduce(gs);
      gs2 = normalize_yb(gs1);
      gs3 = free_reduce(gs2);
  in (n, gs3);

(* ------------------------------------------------------------------ *)
(* Parallel Jones invariance test suite *)
(* ------------------------------------------------------------------ *)

function invariance_suite() =
  let examples = [ yb_invariance_demo() ];
      results = { r[2]: r in examples };
  in reduce(fun (a,b) => a and b, true, results);

(* ------------------------------------------------------------------ *)
(* Nested sequence utilities for coefficient maps *)
(* ------------------------------------------------------------------ *)

function group(a) =
  if #a == 0 then []
  else let x = a[0];
           rest = a[1:#a];
           same = filter(fun y => y[0] == x[0], rest);
           diff = filter(fun y => y[0] != x[0], rest);
       in ([x] ++ same) ++ group(diff);

function sort(a) =
  if #a <= 1 then a
  else let mid = #a / 2;
           l = sort(a[0:mid]);
           r = sort(a[mid:#a]);
       in merge_sorted(l, r);

function merge_sorted(a, b) =
  if #a == 0 then b
  else if #b == 0 then a
  else if a[0][0] <= b[0][0] then
         [a[0]] ++ merge_sorted(a[1:#a], b)
  else [b[0]] ++ merge_sorted(a, b[1:#b]);

(* ------------------------------------------------------------------ *)
(* End of NESL kernel – 400 lines of dense nested data-parallel code *)
(* ------------------------------------------------------------------ *)
