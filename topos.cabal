cabal-version:      3.0
name:               topos
version:            0.1.0.0
synopsis:           Braided DSL for Topological Invariants + TQC Control Loop Formalization
description:
  Sovereign Logic Escape: ENKI Physics to Algebraic Mapping.
  .
  * Prolog/ASP FSA for TQC control loop (quasiparticle poisoning, reset latency)
  * Timing bound derivation (tau_poison 1us-1ms -> lambda <= 150 entropy/ms)
  * Topos.Core Haskell — strand algebra, braid monoid, Yang-Baxter, Jones/Alexander/HOMFLY, Burau
  * Datalog axioms for automated braid equivalence via Yang-Baxter saturation
  * NESL nested data-parallel kernel (parallel YB saturation + Jones on nested sequences)
  * Dataflow / array-parallel kernel (actor graph + SIMD arrays + streaming Jones)
  * Liquid Haskell Kauffman bracket state-sum + Khovanov homology (reflection/PLE proofs)
  * Khovanov differential TQFT cobordism maps (m/delta, sign, d^2=0)
  * TQFT Cobordism double-layer (Frobenius A=Z[X]/X^2, Bar-Natan dotted calculus, d^2=0, categorification)
  * Bar-Natan dotted cobordism RAW DOUBLE-DOUBLE (src/tgt, BN1-BN6, hcomp/vcomp, matrixOf)
  * TQFT Functor F:Cob->Vect_Z (F_id/F_comp, dTQFT, homology, inducedHom, SES/spectral sequence)
license:            AGPL-3.0-only
license-file:       LICENSE
-- Sovereign-Leviathan-Covenant: SL-AGPL3-001 / MGPLv3 (AGPLv3 + additional Sovereign terms)
-- Jurisdiction: England and Wales — see LICENSE
author:             Hilbert Parr / ENKI_PHYSICS_TO_ALGEBRAIC_MAPPING
maintainer:         topos@sovereign.local
category:           Math, Physics, Formal Methods
build-type:         Simple
extra-doc-files:    README.md
                    docs/architecture.md
                    prolog/state_machine.lp
                    prolog/timing.lp
                    prolog/pipeline.lp
                    datalog/braid_axioms.dl
                    nesl/topos.nesl
                    dataflow/topos.df
                    src/Topos/KauffmanKhovanov.hs
                    src/Topos/KhovanovDifferential.hs
                    src/Topos/TQFT/Cobordism.hs
                    src/Topos/BarNatan/DottedCobordism.hs
                    src/Topos/TQFT/Functor.hs
                    examples/trefoil.braid
                    examples/poisoning_trace.txt

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wmissing-export-lists
                 -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library
    import:           warnings
    exposed-modules:  Topos.Core
                    , Topos.KauffmanKhovanov
                    , Topos.KhovanovDifferential
                    , Topos.TQFT.Cobordism
                    , Topos.BarNatan.DottedCobordism
                    , Topos.TQFT.Functor
    hs-source-dirs:   src
    build-depends:    base >= 4.14 && <5
                    , containers >= 0.6
                    , mtl
                    , liquidhaskell
                    , proof-combinators
    default-language: Haskell2010
    ghc-options:      -O2

executable topos-demo
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base
                    , topos
                    , containers
    default-language: Haskell2010

test-suite topos-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base
                    , topos
                    , containers
                    , HUnit
                    , QuickCheck
    default-language: Haskell2010
